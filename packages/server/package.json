{
  "name": "@fte/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && concurrently -n tsc,node -c gray,green \"tsc -b --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fte/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0"
  }
}
